# Configuration for docker compose. Copy the file to switch it on:
#
#   cp .env.example .env
#
# Without .env the defaults noted here apply.

# Port published on the host.
WEB_PORT=3000

# Where the location database lives (~90 MB). It is not in the image.
#
# Two ways, and the only difference is the value of this variable:
#
#   geonames             a volume managed by Docker, filled by
#                        `docker compose --profile setup run --rm geo-import`.
#                        Node need not be installed on the host.
#
#   ./packages/geo/data  a directory on the host: reuses a dataset already
#                        imported with `npm run geo:import`, which is the
#                        convenient choice when working outside containers too.
#
# Any value starting with `.` or `/` is mounted as a bind; anything else is
# taken as a volume name and must be declared in compose.yaml.
GEONAMES_DATA=geonames
